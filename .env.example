# ─── ReqVet SDK ──────────────────────────────────────────────

# --- Mode clinique (chaque clinique a son propre Vetpulse) ---
# Cle API de la clinique — obtenue via le dashboard admin DrVeto
REQVET_API_KEY=rqv_live_VOTRE_CLE_CLINIQUE_ICI
REQVET_WEBHOOK_SECRET=whsec_VOTRE_SECRET_CLINIQUE_ICI

# --- Mode admin reseller (Vetpulse de DrVeto uniquement) -----
# Cle reseller — fournie par ReqVet lors de l'onboarding partenaire
# Si cette variable est definie, /app/admin est disponible
REQVET_RESELLER_API_KEY=rqv_live_reseller_VOTRE_CLE_ICI

REQVET_BASE_URL=https://api.reqvet.com

# URL publique de votre app (pour le callbackUrl du webhook)
# En dev local : utilisez ngrok ou un tunnel similaire
# Ex: NEXT_PUBLIC_APP_URL=https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Turso (LibSQL) — rempli automatiquement par db:create ──
TURSO_DATABASE_URL=libsql://vetpulse-VOTRE_ORG.turso.io
TURSO_AUTH_TOKEN=eyJ...
