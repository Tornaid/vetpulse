# ─── ReqVet SDK ──────────────────────────────────────────────
# Fournis par l'équipe ReqVet lors de l'onboarding pilote
REQVET_API_KEY=rqv_live_VOTRE_CLE_ICI
REQVET_BASE_URL=https://api.reqvet.com
REQVET_WEBHOOK_SECRET=whsec_VOTRE_SECRET_ICI

# URL publique de votre app (pour le callbackUrl du webhook)
# En dev local : utilisez ngrok ou un tunnel similaire
# Ex: NEXT_PUBLIC_APP_URL=https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Turso — API d'administration (pour npm run db:create) ──
# Visible dans l'URL de votre dashboard : app.turso.tech/VOTRE_ORG
TURSO_ORG=VOTRE_ORG_SLUG
# Générez un token dans Settings > API Tokens sur app.turso.tech
TURSO_API_TOKEN=eyJ...

# ─── Turso (LibSQL) — rempli automatiquement par db:create ──
TURSO_DATABASE_URL=libsql://vetpulse-VOTRE_ORG.turso.io
TURSO_AUTH_TOKEN=eyJ...
